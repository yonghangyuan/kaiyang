# 开阳 (Kaiyang) 环境配置
# 复制此文件为 .env 并修改

# ── 数据库 ──
KAIYANG_DATABASE_URL=postgresql+asyncpg://kaiyang:kaiyang@localhost:5432/kaiyang
KAIYANG_DATABASE_URL_SYNC=postgresql+psycopg2://kaiyang:kaiyang@localhost:5432/kaiyang

# ── Redis ──
KAIYANG_REDIS_URL=redis://localhost:6379/0

# ── 服务端口 ──
KAIYANG_PORT=8721
KAIYANG_HOST=0.0.0.0

# ── 天枢 ──
TIANSHU_BASE_URL=http://175.27.157.139:8720
TIANSHU_TOKEN=

# ── 地理编码 ──
# 高德地图 API Key (大陆地理编码)
AMAP_API_KEY=
# Nominatim (全球地理编码，无需 Key，但有限速)
NOMINATIM_USER_AGENT=kaiyang-osint/0.1.0

# ── RSS 源刷新间隔 (秒) ──
RSS_FETCH_INTERVAL=300
