# 开阳 (Kaiyang) 环境配置
# 复制此文件为 .env 并修改

# ── 数据库 ──
# 本地开发用 SQLite（默认，无需配置）
# 生产环境取消注释下面两行，使用 PostgreSQL + PostGIS:
# KAIYANG_DATABASE_URL=postgresql+asyncpg://kaiyang:kaiyang@localhost:5432/kaiyang
# KAIYANG_DATABASE_URL_SYNC=postgresql+psycopg2://kaiyang:kaiyang@localhost:5432/kaiyang

# ── Redis ──
KAIYANG_REDIS_URL=redis://localhost:6379/0

# ── 服务端口 ──
KAIYANG_PORT=8721
KAIYANG_HOST=0.0.0.0

# ── 天枢 ──
KAIYANG_TIANSHU_BASE_URL=http://localhost:8720
KAIYANG_TIANSHU_TOKEN=

# ── 地理编码 ──
KAIYANG_AMAP_API_KEY=
KAIYANG_NOMINATIM_USER_AGENT=kaiyang-osint/0.1.0

# ── RSS 源刷新间隔 (秒) ──
KAIYANG_RSS_FETCH_INTERVAL=300
